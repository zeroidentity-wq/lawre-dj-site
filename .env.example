# Postgres connection string (Neon, Railway, or local)
DATABASE_URI=postgresql://user:password@host:5432/dbname?sslmode=require

# Random secret for Payload (generate: openssl rand -hex 32)
PAYLOAD_SECRET=

# Public URL of the site (used for absolute links in emails, OG tags)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend (transactional email) — optional in dev, required in prod
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=contact@lawredj.ro
EMAIL_FROM_NAME=Lawre DJ

# Cron jobs (GDPR retention) — Bearer token folosit de Vercel Cron / cron extern
# Generează: openssl rand -hex 32
CRON_SECRET=

# Cloudflare R2 (S3-compatible) — added in Faza 4 (deploy)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
